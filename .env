NODE_ENV=production
PORT=3000

# Database Configuration
# ────────────────────────────────────────────────────────────────
# For Railway PostgreSQL deployment:
#   1. Create a PostgreSQL service in Railway
#   2. Copy the DATABASE_URL from Railway's Variables section
#   3. Paste it below and uncomment
# 
# Format: postgresql://user:password@host:port/database
# Example: postgresql://user:abc123xyz@containers-us-west-67.railway.app:8000/railway
#
# DATABASE_URL=postgresql://user:password@host:port/database
#
# For local development:
#   Uncomment and set to your local PostgreSQL:
#   DATABASE_URL=postgresql://postgres:admin@localhost:5432/portfolio_db
